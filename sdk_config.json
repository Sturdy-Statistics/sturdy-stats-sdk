      "wait_status_field": "status",
      "wait_ready": "ready",
      "wait_failed": ["failed"],
      "wait_state_errors": {
        "archived": "is archived. Restore it before waiting for readiness."
      },
      "methods": [
        {
          "name": "list",
          "route": "GET /indices",
          "response_key": ["indices"]
        },
        {
          "name": "create",
          "route": "POST /indices"
        },
        {
