{
  "entities": [
    {
      "class": "Dataset",
      "tag": "datasets",
      "id_param": "dataset_id",
      "id_field": "dataset-id",
      "wait_poll": "GET /datasets/{dataset_id}",
      "wait_status_field": "status",
      "wait_ready": "ready",
      "wait_failed": ["failed"],
      "methods": [
        {
          "name": "list",
          "route": "GET /datasets",
          "response_key": ["datasets"]
        },
        {
          "name": "create",
          "route": "POST /datasets"
        },
        {
          "name": "status",
          "route": "GET /datasets/{dataset_id}"
        },
        {
          "name": "append",
          "route": "POST /datasets/{dataset_id}/append",
          "type": "upload_parquet"
        },
        {
          "name": "commit",
          "route": "POST /datasets/{dataset_id}/commit"
        },
        {
          "name": "append_one",
          "route": "POST /datasets/{dataset_id}/append-one"
        },
        {
          "name": "sql",
          "route": "POST /datasets/{dataset_id}/sql",
          "type": "parquet_response"
        },
        {
          "name": "delete",
          "route": "DELETE /datasets/{dataset_id}"
        },
        {
          "name": "list_permissions",
          "route": "GET /datasets/{dataset_id}/permissions",
          "response_key": ["keys"]
        },
        {
          "name": "grant_permission",
          "route": "POST /datasets/{dataset_id}/permissions/{key_id}"
        },
        {
          "name": "revoke_permission",
          "route": "DELETE /datasets/{dataset_id}/permissions/{key_id}"
        }
      ]
    },
    {
      "class": "Index",
      "tag": "indices",
      "id_param": "index_id",
