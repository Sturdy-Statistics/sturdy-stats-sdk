        {
          "name": "list_topics",
          "route": "GET /indices/{index_id}/topics",
          "response_key": ["topics"]
        },
        {
          "name": "list_topic_groups",
          "route": "GET /indices/{index_id}/topic-groups",
          "response_key": ["groups"]
        },
        {
          "name": "edit_topics",
          "route": "POST /indices/{index_id}/topics/edits",
          "type": "job_response"
        },
        {
          "name": "edit_topic_groups",
          "route": "POST /indices/{index_id}/topic-groups/edits",
          "type": "job_response"
        },
        {
          "name": "archive",
          "route": "POST /indices/{index_id}/archive"
        },
        {
          "name": "restore",
          "route": "POST /indices/{index_id}/restore"
        },
        {
          "name": "delete",
          "route": "DELETE /indices/{index_id}"
        },
        {
          "name": "list_permissions",
          "route": "GET /indices/{index_id}/permissions",
          "response_key": ["keys"]
        },
        {
          "name": "grant_permission",
          "route": "POST /indices/{index_id}/permissions/{key_id}"
        },
        {
          "name": "revoke_permission",
          "route": "DELETE /indices/{index_id}/permissions/{key_id}"
        }
      ]
