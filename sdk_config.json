          "response_key": ["topics"]
        },
        {
          "name": "search",
          "route": "POST /indices/{index_id}/docs/search",
          "response_key": ["results"],
          "param_order": [
            "level",
            "search-query",
            "filter",
            "topic-ids",
            "sort-by",
            "topic-mention-cutoff",
            "semantic-search-cutoff",
            "semantic-search-weight",
            "limit",
            "context",
            "max-excerpts-per-doc",
            "topic-mention-criteria",
            "summary-level"
          ]
        },
        {
          "name": "sql",
